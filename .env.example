# Copy this file to .env and adjust:  cp .env.example .env
# Docker Compose reads .env automatically.

# Which Compose files to combine. Remove ":docker-compose.gpu.yml" to run on CPU only.
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# Ollama image version (see https://hub.docker.com/r/ollama/ollama/tags)
OLLAMA_VERSION=0.40.11

# Where the app finds the model server (the service name "ollama", not localhost)
LLM_BASE_URL=http://ollama:11434/v1

# Model: qwen3:4b-q4_K_M (default), qwen3:1.7b (fast), qwen3:8b (slow, best quality)
LLM_MODEL=qwen3:4b-q4_K_M

# Max tokens the model can see at once (prompt + history + answer)
LLM_CONTEXT_SIZE=4096

# Qwen3 "thinking" mode: true = slower, reasons before answering
LLM_THINKING=false

# Save each chat session to traces/ (not committed; contains everything you type)
LLM_TRACE=true

# Your user and group id (run: id -u ; id -g), so files the app creates belong to you
HOST_UID=1000
HOST_GID=1000
